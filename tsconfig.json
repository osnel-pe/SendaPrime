{
  "compilerOptions": {

    "target":"ES2022",

    "module":"ESNext",

    "moduleResolution":"Bundler",

    "jsx":"react-jsx",

    "types":[
      "react",
      "react-dom"
    ],

    "strict":true,

    "allowJs":false,

    "checkJs":false,

    "resolveJsonModule":true,

    "isolatedModules":true,

    "lib":[
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ]

  },

  "include":[
    "src"
  ],

  "exclude":[
    "node_modules"
  ]
}